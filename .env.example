# Furniture Hub Dhangadhi - Environment Variables Template
# Optional: Supabase configuration for cloud database & authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Authentication & Redirect Settings
VITE_SUPABASE_AUTH_REDIRECT_URL=https://your-domain.vercel.app/
VITE_GOOGLE_OAUTH_ENABLED=true
VITE_EMAIL_VERIFICATION_ENFORCED=true

# Store WhatsApp Number (Nepal Country Code 977 + Mobile)
VITE_SELLER_WHATSAPP_NUMBER=9779841234567
